# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Relay-flow secrets — NEVER commit real values ──
# The `.example` sibling of google-services.json stays in git; the real
# credentials file must not.
android/app/google-services.json
android/key.properties
*.jks
*.keystore

# Forge recipe — holds plaintext secrets (AppsFlyer dev key, messaging
# project number, config endpoint). `forge.lock` carries only the
# identifying tuple and IS committed as the per-project audit trail.
tool/forge/recipe.json

# Symbol table produced by --split-debug-info.
build/debug_info/

# Rust build artifacts for the native seal gate. The prebuilt .so files
# under android/app/src/main/jniLibs ARE committed; the target/ dir is not.
native/**/target/


# Local dev scratch under tool/ (screenshots, UI dumps, one-off scripts).
tool/_*
