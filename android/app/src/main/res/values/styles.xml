<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. It paints the brand violet
         rather than the launcher icon on white, which is what produces the
         white frame flash on cold start (gray_part_pitfalls.md §16C). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Same cutout mode as NormalTheme, so the window geometry does not
             change underneath the first frame. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- Window theme once the engine is up, and the background behind the
         Flutter UI while it initialises. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash</item>
        <!--
            Lets the window extend under the camera cutout, and — the reason
            it is here — keeps Android REPORTING the cutout inset even while
            the status and navigation bars are hidden by immersiveSticky.
            Without it MediaQuery.viewPadding comes back as zero and the
            WebView draws under the notch (gray_part_pitfalls.md §14; see
            lib/app/chrome_guard.dart and lib/relay/stage/portal_stage.dart).
        -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
